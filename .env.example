NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# QZ Tray Silent Printing Security (Required for /api/qz/cert and /api/qz/sign)
# Configure these in your Vercel Project Settings -> Environment Variables.
# QZ_CERT: Public X.509 PEM certificate (begins with -----BEGIN CERTIFICATE-----)
# QZ_PRIVATE_KEY: Private RSA key (begins with -----BEGIN PRIVATE KEY-----)
QZ_CERT=
QZ_PRIVATE_KEY=
