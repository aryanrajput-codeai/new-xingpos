{
  "name": "xings-kitchen-pos",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "test": "tsx scripts/test-ingredient-management.ts && tsx scripts/test-recipe-management.ts && tsx scripts/test-purchase-management.ts",
    "test:ingredients": "tsx scripts/test-ingredient-management.ts",
    "test:recipes": "tsx scripts/test-recipe-management.ts",
    "test:purchases": "tsx scripts/test-purchase-management.ts",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder --win --x64 -c.directories.output=releases/desktop-app/windows",
    "electron:build:mac": "npm run build && electron-builder --mac dmg zip dir -c.directories.output=releases/desktop-app/mac"
  },
  "build": {
    "appId": "com.webrajya.xingskitchen.desktop",
    "productName": "XINGS KITCHEN",
    "copyright": "Copyright © 2026 Webrajya",
    "publish": [
      {
        "provider": "github",
        "owner": "aryanrajput-codeai",
        "repo": "new-xingpos"
      }
    ],
    "directories": {
      "output": "releases/desktop-app"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "mac-print-bridge/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "XINGS-KITCHEN",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "XINGS KITCHEN",
      "artifactName": "XINGS-KITCHEN-Desktop-Setup.exe"
    },
    "portable": {
      "artifactName": "XINGS-KITCHEN-Desktop-Portable.exe"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "identity": null
    },
    "dmg": {
      "artifactName": "XINGS-KITCHEN-Desktop-Setup.dmg"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^7.2.0"
  }
}
